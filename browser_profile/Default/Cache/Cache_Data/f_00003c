ore Banking DB...</span></span><br><span style=\"background-color:transparent;color:#263238;font-family:Consolas,sans-serif;font-size:8pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; System.out.println(\"Core Banking: Transferred \" + amount + \" to account \" + toAccount);</span></span><br><span style=\"background-color:transparent;color:#263238;font-family:Consolas,sans-serif;font-size:8pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</span></span><br><span style=\"background-color:transparent;color:#263238;font-family:Consolas,sans-serif;font-size:8pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; // Gọi phương thức ghi chép kiểm toán bất đồng bộ</span></span><br><span style=\"background-color:transparent;color:#263238;font-family:Consolas,sans-serif;font-size:8pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; this.writeAuditLog(toAccount, amount);</span></span><br><span style=\"background-color:transparent;color:#263238;font-family:Consolas,sans-serif;font-size:8pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">&nbsp; &nbsp; &nbsp; &nbsp; }</span></span><br><br><span style=\"background-color:transparent;color:#263238;font-family:Consolas,sans-serif;font-size:8pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">&nbsp; &nbsp; &nbsp; &nbsp; @Async</span></span><br><span style=\"background-color:transparent;color:#263238;font-family:Consolas,sans-serif;font-size:8pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">&nbsp; &nbsp; &nbsp; &nbsp; public void writeAuditLog(String toAccount, double amount) {</span></span><br><span style=\"background-color:transparent;color:#263238;font-family:Consolas,sans-serif;font-size:8pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; // Lấy thông tin người thực hiện giao dịch (Audit Log)</span></span><br><span style=\"background-color:transparent;color:#263238;font-family:Consolas,sans-serif;font-size:8pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; String currentUser = SecurityContextHolder.getContext().getAuthentication().getName();</span></span><br><span style=\"background-color:transparent;color:#263238;font-family:Consolas,sans-serif;font-size:8pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; System.out.println(\"Audit log: transaction initiated by user \" + currentUser);</span></span><br><span style=\"background-color:transparent;color:#263238;font-family:Consolas,sans-serif;font-size:8pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</span></span><br><span style=\"background-color:transparent;color:#263238;font-family:Consolas,sans-serif;font-size:8pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; // Giả lập tiến trình ghi Audit Log tốn thời gian</span></span><br><span style=\"background-color:transparent;color:#263238;font-family:Consolas,sans-serif;font-size:8pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; try {</span></span><br><span style=\"background-color:transparent;color:#263238;font-family:Consolas,sans-serif;font-size:8pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Thread.sleep(2000);</span></span><br><span style=\"background-color:transparent;color:#263238;font-family:Consolas,sans-serif;font-size:8pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; } catch (InterruptedException e) {</span></span><br><span style=\"background-color:transparent;color:#263238;font-family:Consolas,sans-serif;font-size:8pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; e.printStackTrace();</span></span><br><span style=\"background-color:transparent;color:#263238;font-family:Consolas,sans-serif;font-size:8pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; }</span></span><br><span style=\"background-color:transparent;color:#263238;font-family:Consolas,sans-serif;font-size:8pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</span></span><br><span style=\"background-color:transparent;color:#263238;font-family:Consolas,sans-serif;font-size:8pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; System.out.println(\"Audit log successfully written to database for transaction to \" + toAccount);</span></span><br><span style=\"background-color:transparent;color:#263238;font-family:Consolas,sans-serif;font-size:8pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">&nbsp; &nbsp; &nbsp; &nbsp; }</span></span><br><span style=\"background-color:transparent;color:#263238;font-family:Consolas,sans-serif;font-size:8pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">&nbsp; &nbsp; }</span></span></p></td></tr></tbody></table></figure></div><p>&nbsp;</p><p><span style=\"background-color:transparent;color:#263238;font-family:Calibri,sans-serif;font-size:10.5pt;\"><span style=\"font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\"><strong>Đề bài</strong></span><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">:</span></span></p><p style=\"line-height:1.355;margin-bottom:5pt;margin-top:0pt;text-align:justify;\" dir=\"ltr\"><span style=\"background-color:transparent;color:#263238;font-family:Calibri,sans-serif;font-size:10.5pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">Bạn hãy thực hiện:</span></span></p><ol style=\"margin-bottom:0;margin-top:0;padding-inline-start:48px;\"><li style=\"background-col