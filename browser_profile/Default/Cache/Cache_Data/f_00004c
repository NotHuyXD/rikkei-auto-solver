ace:pre-wrap;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; // Hardcode API Keys trực tiếp trong mã nguồn</span></span><br><span style=\"background-color:transparent;color:#263238;font-family:Consolas,sans-serif;font-size:8pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; return new LangfuseClient(</span></span><br><span style=\"background-color:transparent;color:#263238;font-family:Consolas,sans-serif;font-size:8pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \"pk-lf-1234567890abcdef\",&nbsp;</span></span><br><span style=\"background-color:transparent;color:#263238;font-family:Consolas,sans-serif;font-size:8pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \"sk-lf-0987654321fedcba\",&nbsp;</span></span><br><span style=\"background-color:transparent;color:#263238;font-family:Consolas,sans-serif;font-size:8pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; \"https://cloud.langfuse.com\"</span></span><br><span style=\"background-color:transparent;color:#263238;font-family:Consolas,sans-serif;font-size:8pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; );</span></span><br><span style=\"background-color:transparent;color:#263238;font-family:Consolas,sans-serif;font-size:8pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;ver