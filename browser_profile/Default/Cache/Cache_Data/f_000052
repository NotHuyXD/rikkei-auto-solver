e-wrap;\">,&nbsp;</span></span><span style=\"background-color:transparent;color:#12324a;font-family:Consolas,sans-serif;font-size:9pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">secretKey</span></span><span style=\"background-color:transparent;color:#263238;font-family:Calibri,sans-serif;font-size:10.5pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\"> khai báo trong&nbsp;</span></span><span style=\"background-color:transparent;color:#12324a;font-family:Consolas,sans-serif;font-size:9pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">application.yml</span></span><span style=\"background-color:transparent;color:#263238;font-family:Calibri,sans-serif;font-size:10.5pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">.</span></span></li></ul><ol style=\"margin-bottom:0;margin-top:0;padding-inline-start:48px;\" start=\"2\"><li style=\"background-color:transparent;color:#263238;font-family:Calibri,sans-serif;font-size:10.5pt;font-style:normal;font-variant:normal;font-weight:400;list-style-type:decimal;text-decoration:none;vertical-align:baseline;white-space:pre;\" dir=\"ltr\" aria-level=\"2\"><span style=\"background-color:transparent;color:#263238;font-family:Calibri,sans-serif;font-size:10.5pt;\"><span style=\"font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\"><strong>Xây dựng `PromptRegistryService.java`:</strong></span></span></li></ol><ul style=\"margin-bottom:0;margin-top:0;padding-inline-start:48px;\"><li style=\"background-color:transparent;color:#263238;font-family:'Noto Sans Symbols',sans-serif;font-size:10.5pt;font-style:normal;font-variant:normal;font-weight:400;list-style-type:disc;text-decoration:none;vertical-align:baseline;white-space:pre;\" dir=\"ltr\" aria-level=\"1\"><span style=\"background-color:transparent;color:#263238;font-family:Calibri,sans-serif;font-size:10.5pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">Triển khai phương thức&nbsp;</span></span><span style=\"background-color:transparent;color:#12324a;font-family:Consolas,sans-serif;font-size:9pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">String getPrompt(String promptName, Map&lt;String, Object&gt; variables)</span></span><span style=\"background-color:transparent;color:#263238;font-family:Calibri,sans-serif;font-size:10.5pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">:</span></span></li><li style=\"background-color:transparent;color:#263238;font-family:'Noto Sans Symbols',sans-serif;font-size:10.5pt;font-style:normal;font-variant:normal;font-weight:400;list-style-type:disc;text-decoration:none;vertical-align:baseline;white-space:pre;\" dir=\"ltr\" aria-level=\"1\"><span style=\"background-color:transparent;color:#263238;font-family:Calibri,sans-serif;font-size:10.5pt;\"><span style=\"font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\"><strong>Tầng 1 - Remote Fetch:</strong></span><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\"> Gọi SDK Langfuse để lấy prompt theo tên (ví dụ:&nbsp;</span></span><span style=\"background-color:transparent;color:#12324a;font-family:Consolas,sans-serif;font-size:9pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">banking_transfer_prompt</span></span><span style=\"background-color:transparent;color:#263238;font-family:Calibri,sans-serif;font-size:10.5pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">) với nhãn&nbsp;</span></span><span style=\"background-color:transparent;color:#12324a;font-family:Consolas,sans-serif;font-size:9pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">production</span></span><span style=\"background-color:transparent;color:#263238;font-family:Calibri,sans-serif;font-size:10.5pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">.</span></span></li><li style=\"background-color:transparent;color:#263238;font-family:'Noto Sans Symbols',sans-serif;font-size:10.5pt;font-style:normal;font-variant:normal;font-weight:400;list-style-type:disc;text-decoration:none;vertical-align:baseline;white-space:pre;\" dir=\"ltr\" aria-level=\"1\"><span style=\"background-color:transparent;color:#263238;font-family:Calibri,sans-serif;font-size:10.5pt;\"><span style=\"font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\"><strong>Tầng 2 - In-Memory Cache:</strong></span><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\"> Tích hợp bộ đệm cục bộ (bằng&nbsp;</span></span><span style=\"background-color:transparent;color:#12324a;font-family:Consolas,sans-serif;font-size:9pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">ConcurrentHashMap</span></span><span style=\"background-color:transparent;color:#263238;font-family:Calibri,sans-serif;font-size:10.5pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\"> có TTL hoặc&nbsp;</span></span><span style=\"background-color:transparent;color:#12324a;font-family:Consolas,sans-serif;font-size:9pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">Caffeine Cache</span></span><span style=\"background-color:transparent;color:#263238;font-family:Calibri,sans-serif;font-size:10.5pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\"> /&nbsp;</span></span><span style=\"background-color:transparent;color:#12324a;font-family:Consolas,sans-serif;font-size:9pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">Spring Cache</span></span><span style=\"background-color:transparent;color:#263238;font-family:Calibri,sans-serif;font-size:10.5pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\"> 60 giây) để tránh gửi HTTP request liên tục lên Langfuse Server ở mỗi lượt gọi LLM, giảm latency xuống ~0ms.</span></span></li><li style=\"background-color:transparent;color:#263238;font-family:'Noto Sans Symbols',sans-serif;font-size:10.5pt;font-style:normal;font-variant:normal;font-weight:400;list-style-type:disc;text-decoration:none;vertical-align:baseline;white-space:pre;\" dir=\"ltr\" aria-level=\"1\"><span style=\"background-color:transparent;color:#263238;font-family:Calibri,sans-serif;font-size:10.5pt;\"><span style=\"font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\"><strong>Tầng 3 - Defensive Fallback:</strong></span><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\"> Đặt logic lấy prompt trong khối&nbsp;</span></span><span style=\"background-color:transparent;color:#12324a;font-family:Consolas,sans-serif;font-size:9pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">try-catch</span></span><span style=\"background-color:transparent;color:#263238;font-family:Calibri,sans-serif;font-size:10.5pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">. Nếu Langfuse Server bị offline, timeout hoặc lỗi kết nối, tự động chuyển sang sử dụng&nbsp;</span></span><span style=\"background-color:transparent;color:#12324a;font-family:Consolas,sans-serif;font-size:9pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\">DEFAULT_FALLBACK_PROMPT</span></span><span style=\"background-color:transparent;color:#263238;font-family:Calibri,sans-serif;font-size:10.5pt;\"><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\"> được định nghĩa sẵn trong mã nguồn Java.</span></span></li><li style=\"background-color:transparent;color:#263238;font-family:'Noto Sans Symbols',sans-serif;font-size:10.5pt;font-style:normal;font-variant:normal;font-weight:400;list-style-type:disc;text-decoration:none;vertical-align:baseline;white-space:pre;\" dir=\"ltr\" aria-level=\"1\"><span style=\"background-color:transparent;color:#263238;font-family:Calibri,sans-serif;font-size:10.5pt;\"><span style=\"font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\"><strong>Tầng 4 - Compile Variables:</strong></span><span style=\"font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap;\"